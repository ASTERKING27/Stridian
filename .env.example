# Copy this file to .env (same folder) and fill it in. Never commit .env — it is in
# .gitignore. On Vercel, the same names go in Project -> Settings -> Environment Variables.

# --- database: the Neon connection string (Dashboard -> Connect). Leave empty to use a
# local SQLite file, which is fine for trying things on one computer.
DATABASE_URL=

# --- coaches must type this to create an account. Set it before going public.
COACH_SIGNUP_CODE=

# --- students' sign-in codes are emailed from this Gmail account. SMTP_PASSWORD is an
# app password (needs 2-Step Verification; make one at
# https://myaccount.google.com/apppasswords), never the account's real password.
# Left empty on a laptop, the code is printed in the server's terminal instead.
SMTP_USER=
SMTP_PASSWORD=

# --- Google (videos in Drive + the squad sheet). Client ID/secret come from Google
# Cloud -> APIs & Services -> Credentials -> OAuth client (Desktop app). Then run
#   python backend/setup_google.py
# which fills in the rest of this block by itself.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SHEET_ID=
STORAGE=local

# --- optional
# TIMEZONE=Asia/Kolkata          dates in the sheet
# STUDENT_EMAIL_DOMAIN=srmist.edu.in   only emails ending in this can make student accounts
# VIDEO_RETENTION_DAYS=30        the worker deletes video files older than this
